<title>Mesa de Trabalho</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Staatliches&family=Poppins:wght@300;400;600;700&family=Caladea:wght@400;700&family=Montserrat:wght@300;400;600;700&family=Afacad:wght@400;700&family=Instrument+Sans:wght@400;600&display=swap">
<style>
  /* Ferramenta de arte: escuro por escolha, não por omissão — chrome claro
     em volta de lâminas escuras falseia a leitura da própria arte. */
  :root{
    --ground:#0a0b0d; --stage:#0d0e11; --surface:#17191c; --raised:#1f2226;
    --line:#1c1f23; --line-2:#2b2f34;
    --ink:#e8e9ea; --dim:#7e848b; --mute:#565c63;
    --accent:#d42126; --warn:#f0b429;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0; background:var(--ground); color:var(--ink);
    font:14px/1.5 "IBM Plex Sans",system-ui,-apple-system,sans-serif;
    -webkit-font-smoothing:antialiased; overflow:hidden;
  }
  button,input,select,textarea{font:inherit;color:inherit;background:none;border:none}
  button{cursor:pointer}
  a{color:var(--accent)} a:hover{color:#f0575c}
  .mono{font-family:"IBM Plex Mono",ui-monospace,monospace}
  :focus-visible{outline:2px solid var(--accent); outline-offset:2px}

  .app{display:flex; flex-direction:column; height:100vh}

  /* ---------- barra superior ---------- */
  .top{
    height:56px; flex:none; border-bottom:1px solid var(--line);
    display:flex; align-items:center; gap:22px; padding:0 18px;
  }
  .marca{display:flex; align-items:center; gap:9px; flex:none}
  .marca i{width:9px; height:9px; background:var(--accent); display:block}
  .marca b{font-size:13px; font-weight:600; letter-spacing:.02em}

  .perfis{display:flex; gap:2px; align-items:center; overflow-x:auto; scrollbar-width:none}
  .perfis::-webkit-scrollbar{display:none}
  .perfil{
    display:flex; align-items:center; gap:7px; padding:8px 12px; white-space:nowrap;
    border:1px solid transparent; color:var(--dim); font-size:12.5px; min-height:38px;
  }
  .perfil i{width:7px; height:7px; border-radius:50%; display:block; flex:none}
  .perfil:hover{color:var(--ink)}
  .perfil[aria-pressed="true"]{background:var(--surface); border-color:var(--line-2); color:var(--ink); font-weight:500}

  .conta{margin-left:auto; font-size:11.5px; color:var(--mute); flex:none}
  .exportar{
    display:flex; align-items:center; gap:8px; padding:9px 16px; min-height:38px;
    background:var(--accent); color:#fff; font-size:13px; font-weight:600; flex:none;
  }
  .exportar:hover{background:#ef2f34}

  /* ---------- corpo ---------- */
  .corpo{flex:1; display:flex; min-height:0}
  .centro{flex:1; display:flex; flex-direction:column; min-width:0; background:var(--stage)}

  .palco{
    flex:1; display:flex; align-items:center; justify-content:center; gap:26px;
    padding:26px 30px; min-height:0; overflow:hidden;
  }
  .lam{flex:none; display:flex; flex-direction:column; align-items:flex-start; cursor:pointer}
  .lam .arte{position:relative; overflow:hidden; background:#111}
  .lam .cap{margin-top:9px; font-size:10.5px; color:var(--mute); letter-spacing:.03em}
  .lam[data-foco="1"] .cap{color:var(--accent)}
  .lam[data-foco="0"]{opacity:.72}
  .lam[data-foco="0"]:hover{opacity:.92}
  .lam[data-foco="1"] .arte{outline:2px solid var(--accent); outline-offset:-1px}

  /* elementos clicáveis dentro da arte */
  .alvo{cursor:pointer}
  .alvo:hover{box-shadow:inset 0 0 0 2px rgba(212,33,38,.45)}
  .alvo[data-sel="1"]{box-shadow:inset 0 0 0 2px var(--accent); background:rgba(212,33,38,.06)}
  .selo{
    position:absolute; background:var(--accent); color:#fff; font-weight:600;
    letter-spacing:.04em; z-index:3; pointer-events:none;
  }

  /* ---------- esteira ---------- */
  .esteira{
    height:96px; flex:none; border-top:1px solid var(--line);
    display:flex; align-items:center; gap:10px; padding:0 18px; overflow-x:auto;
  }
  .quadro{
    width:48px; height:60px; flex:none; position:relative; overflow:hidden;
    border:1px solid var(--line-2); background:var(--surface); cursor:pointer; padding:0;
  }
  .quadro[data-foco="1"]{border-color:var(--accent); border-width:2px}
  .quadro .n{
    position:absolute; left:0; top:0; padding:1px 4px; font-size:9px; font-weight:600;
    background:rgba(0,0,0,.55); color:#fff; z-index:2;
  }
  .quadro .fita{position:absolute; inset:0; transform-origin:top left}
  .quadro .alerta{position:absolute; right:2px; bottom:2px; width:11px; height:11px; background:var(--warn); z-index:2}
  .maisq{
    width:48px; height:60px; flex:none; border:1px dashed #33383e; color:var(--dim);
    display:grid; place-items:center;
  }
  .maisq:hover{border-color:var(--accent); color:var(--accent)}

  /* ---------- painel ---------- */
  .painel{
    width:308px; flex:none; border-left:1px solid var(--line);
    display:flex; flex-direction:column; overflow-y:auto;
  }
  .pcab{padding:15px 18px; border-bottom:1px solid var(--line)}
  .pcab .k{font-size:10px; color:var(--mute); letter-spacing:.1em}
  .pcab .v{margin-top:5px; font-size:14px; font-weight:500}
  .pbloco{padding:16px 18px; display:flex; flex-direction:column; gap:15px}
  .rot{font-size:10px; color:var(--mute); letter-spacing:.1em; margin-bottom:8px}

  textarea.campo,input.campo{
    width:100%; background:#0f1114; border:1px solid var(--line-2);
    padding:10px 11px; font-size:13.5px; line-height:1.5; resize:vertical;
  }
  textarea.campo:focus,input.campo:focus{border-color:var(--accent); outline:none}
  select.campo{
    width:100%; background:#0f1114; border:1px solid var(--line-2);
    padding:9px 11px; font-size:13.5px; min-height:38px; cursor:pointer;
  }

  .foco-img{height:112px; border:1px solid var(--line-2); position:relative; overflow:hidden; background:#0f1114}
  .foco-img img{position:absolute; max-width:none}
  .foco-img .janela{position:absolute; inset:0; box-shadow:inset 0 0 0 1.5px var(--accent); pointer-events:none}

  .ctrl{display:flex; flex-direction:column; gap:7px}
  .ctrl .lin{display:flex; justify-content:space-between; align-items:baseline}
  .ctrl .lin span:first-child{font-size:12px; color:#a9afb6}
  .ctrl .lin span:last-child{font-size:11.5px}
  .ctrl input[type=range]{width:100%; accent-color:var(--accent); height:20px}
  .ctrl[data-off="1"]{opacity:.4}
  .ctrl[data-off="1"] .lin span:first-child{color:var(--mute)}

  .aviso{display:flex; gap:9px; padding:11px; background:rgba(240,180,41,.08); border-left:2px solid var(--warn)}
  .aviso b{display:block; font-size:12px; color:var(--warn); font-weight:500}
  .aviso p{margin:3px 0 0; font-size:11.5px; color:#8d939a; line-height:1.45}

  .btn-lin{display:flex; gap:8px}
  .btn2{
    flex:1; padding:9px 12px; min-height:38px; border:1px solid var(--line-2);
    background:var(--surface); font-size:12.5px; text-align:center;
  }
  .btn2:hover{border-color:#3d444d; background:var(--raised)}
  .btn2.perigo:hover{border-color:var(--accent); color:#f0575c}
  .vazio{padding:26px 18px; color:var(--mute); font-size:13px; line-height:1.55}

  .toast{
    position:fixed; bottom:22px; left:50%; transform:translateX(-50%) translateY(8px);
    background:var(--raised); border:1px solid var(--line-2); padding:10px 16px;
    font-size:13px; opacity:0; pointer-events:none; transition:.18s; z-index:50;
  }
  .toast.on{opacity:1; transform:translateX(-50%)}
  @media (prefers-reduced-motion:reduce){ .toast{transition:none} }
</style>
