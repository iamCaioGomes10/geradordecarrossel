  var CONTEUDO = {
    capa:   { titulo: "Por que o dólar subiu 4% em uma semana", sub: "E o que isso muda na sua carteira agora." },
    texto:  { titulo: "O que aconteceu", corpo: "O Fed sinalizou juros altos por mais tempo, e **capital estrangeiro saiu de mercados emergentes**. O real foi junto com pares latino-americanos." },
    imagem: { titulo: "Onde isso pesa", corpo: "Importadores e empresas endividadas em dólar sentem primeiro. Exportadoras de commodities **tendem a se beneficiar** no curto prazo." },
    texto2: { titulo: "O que fazer", corpo: "Nada às pressas. **Reveja a exposição cambial** e confira se o percentual em ativos internacionais ainda bate com o que você definiu." }
  };

  var e = {
    marca: "suno",
    foco: 1,
    sel: "corpo",
    laminas: []
  };

  function chaves(marca) { return Object.keys(M[marca].tipos); }
  function forma(marca, tipo) { var t = M[marca].tipos[tipo]; return t ? t[1] : "texto"; }
  function rotulo(marca, tipo) { var t = M[marca].tipos[tipo]; return t ? t[0] : tipo; }

  function semear() {
    var ks = chaves(e.marca);
    var kCapa = ks[0];
    var kTexto = ks.filter(function (k) { return forma(e.marca, k) === "texto"; })[0] || ks[1];
    var kImg = ks.filter(function (k) { return forma(e.marca, k) === "imagem"; })[0] || ks[1];
    e.laminas = [
      { tipo: kCapa,  titulo: CONTEUDO.capa.titulo, sub: CONTEUDO.capa.sub, corpo: "", img: true,  zoom: 1, fx: .5, fy: .5, n: "" },
      { tipo: kTexto, titulo: CONTEUDO.texto.titulo, sub: "", corpo: CONTEUDO.texto.corpo, img: false, zoom: 1, fx: .5, fy: .5, n: "1" },
      { tipo: kImg,   titulo: CONTEUDO.imagem.titulo, sub: "", corpo: CONTEUDO.imagem.corpo, img: true, zoom: 1.48, fx: .5, fy: .62, n: "2" },
      { tipo: kTexto, titulo: CONTEUDO.texto2.titulo, sub: "", corpo: CONTEUDO.texto2.corpo + " " + CONTEUDO.texto2.corpo, img: false, zoom: 1, fx: .5, fy: .5, n: "3" }
    ];
    if (e.foco >= e.laminas.length) e.foco = e.laminas.length - 1;
  }
