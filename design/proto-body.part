<div class="app">
  <div class="top">
    <div class="marca"><i></i><b>Carrossel</b></div>
    <div class="perfis" id="perfis" role="group" aria-label="Perfil"></div>
    <span class="conta mono" id="conta"></span>
    <button class="exportar" id="exportar">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Exportar
    </button>
  </div>

  <div class="corpo">
    <div class="centro">
      <div class="palco" id="palco"></div>
      <div class="esteira" id="esteira"></div>
    </div>
    <aside class="painel" id="painel"></aside>
  </div>
</div>
<div class="toast" id="toast"></div>
